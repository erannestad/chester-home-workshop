---
import Base from '../layouts/Base.astro';
import PageColumns from '../components/PageColumns.astro';
import { link } from '../lib/site';
---

<Base title="Page not found">
  <PageColumns label="Page not found">
    <div slot="side">
      <h1 class="title">Page not found</h1>
      <p>That page may have moved, or the item may no longer be listed.</p>
      <p><a href={link('/shop/')}>Browse the shop</a> or <a href={link('/')}>return home</a>.</p>
    </div>
  </PageColumns>
</Base>
