---
import Base from '../../layouts/Base.astro';
import Column from '../../components/Column.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategories, getProducts } from '../../lib/catalog';
import { link } from '../../lib/site';

const categories = await getCategories();
const products = await getProducts();
const uncategorized = products.filter((p) => !categories.some((c) => c.id === p.category));
const columns = [
  ...categories.map((c) => ({ label: c.title, href: link(`/shop/${c.id}/`), items: products.filter((p) => p.category === c.id) })),
  ...(uncategorized.length ? [{ label: 'Other', href: undefined, items: uncategorized }] : []),
];
---

<Base title="Shop">
  <h1 class="visually-hidden">Shop</h1>
  {
    products.length === 0 && (
      <Column label="Shop">
        <p class="empty">Nothing is listed right now. <a href={link('/contact/')}>Get in touch</a> to ask about current work.</p>
      </Column>
    )
  }
  {
    columns.map((col, ci) => (
      <Column label={col.label} href={col.href}>
        {col.items.map((p, i) => (
          <ProductCard product={p} index={i + 1} priority={ci < 3 && i === 0} />
        ))}
        {col.items.length === 0 && <p class="empty">Nothing listed right now.</p>}
      </Column>
    ))
  }
</Base>
