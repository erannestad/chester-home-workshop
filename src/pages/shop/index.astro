---
import Base from '../../layouts/Base.astro';
import Column from '../../components/Column.astro';
import ProductCard from '../../components/ProductCard.astro';
import ShopAside from '../../components/ShopAside.astro';
import { getCategories, getProducts } from '../../lib/catalog';
import { link } from '../../lib/site';

const categories = await getCategories();
const products = await getProducts();
---

<Base title="Shop">
  <ShopAside title="Shop" count={products.length} categories={categories} />
  <Column journal>
    {
      products.length > 0 ? (
        <div class="shop-grid">
          {products.map((p, i) => (
            <ProductCard product={p} index={i + 1} priority={i < 3} />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing is listed right now. <a href={link('/contact/')}>Get in touch</a> to ask about current work.</p>
      )
    }
  </Column>
</Base>
