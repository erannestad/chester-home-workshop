---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Column from '../../components/Column.astro';
import ProductCard from '../../components/ProductCard.astro';
import ShopAside from '../../components/ShopAside.astro';
import { getCategories, getProducts, type Category } from '../../lib/catalog';
import { link } from '../../lib/site';

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}) satisfies GetStaticPaths;

const { category } = Astro.props as { category: Category };
const categories = await getCategories();
const products = (await getProducts()).filter((p) => p.category === category.id);
---

<Base title={category.title} description={category.summary}>
  <ShopAside
    title={category.title}
    count={products.length}
    categories={categories}
    current={category.id}
    summary={category.summary}
    bodyHtml={category.bodyHtml}
  />
  <Column label={category.title} journal>
    {
      products.length > 0 ? (
        <div class="shop-grid">
          {products.map((p, i) => (
            <ProductCard product={p} index={i + 1} priority={i < 3} />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing is listed here right now. <a href={link('/contact/')}>Get in touch</a> to ask about current work.</p>
      )
    }
  </Column>
</Base>
