---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageColumns from '../components/PageColumns.astro';
import { settings, instagramUrl, instagramHandle, facebookUrl } from '../lib/site';
import { siteConfig } from '../site.config';

const page = await getEntry('pages', 'contact');
const { Content } = page ? await render(page) : { Content: null };
const endpoint = siteConfig.formEndpoint;
const tel = settings.phone.replace(/[^\d+]/g, '');
---

<Base title={page?.data.title || 'Contact'} description={page?.data.intro}>
  <PageColumns label={page?.data.title || 'Contact'} mainLabel="Write to us">
    <dl slot="side" class="rows">
      <div>
        <dt><h1 class="title">{page?.data.heading || 'Contact'}</h1></dt>
        <dd>
          {page?.data.intro && <p>{page.data.intro}</p>}
          <div class="prose">{Content && <Content />}</div>
        </dd>
      </div>
      {settings.email && <div class="row-tight"><dt>Email</dt><dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd></div>}
      {settings.phone && <div class="row-tight"><dt>Phone</dt><dd><a href={`tel:${tel}`}>{settings.phone}</a></dd></div>}
      {settings.instagram && <div class="row-tight"><dt>Instagram</dt><dd><a href={instagramUrl(settings.instagram)}>{instagramHandle(settings.instagram)}</a></dd></div>}
      {settings.facebook && <div class="row-tight"><dt>Facebook</dt><dd><a href={facebookUrl(settings.facebook)}>{settings.site_name}</a></dd></div>}
      {settings.location && <div class="row-tight"><dt>Location</dt><dd>{settings.location}</dd></div>}
    </dl>
    <p class="asking" id="asking" hidden>Asking about: <em id="asking-item"></em></p>
    {
      endpoint ? (
        <form class="form" method="post" action={endpoint}>
          <label>
            Name
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            Email
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            Item or service (optional)
            <input name="item" id="item" />
          </label>
          <label>
            Message
            <textarea name="message" id="message" required />
          </label>
          <button class="button" type="submit">Send</button>
        </form>
      ) : (
        settings.email && (
          <p>
            <a class="button" id="mail-button" data-email={settings.email} href={`mailto:${settings.email}?subject=Inquiry`}>
              Write to us
            </a>
          </p>
        )
      )
    }
  </PageColumns>

  <!-- Pre-fills the inquiry when arriving from a product page (/contact/?item=...). -->
  <script is:inline>
    (function () {
      var item = new URLSearchParams(location.search).get('item');
      if (!item) return;
      document.getElementById('asking-item').textContent = item;
      document.getElementById('asking').hidden = false;
      var field = document.getElementById('item');
      if (field) field.value = item;
      var msg = document.getElementById('message');
      if (msg && !msg.value) msg.value = 'Hello, I am interested in ' + item + '.\n\n';
      var btn = document.getElementById('mail-button');
      if (btn) {
        btn.href =
          'mailto:' + btn.dataset.email +
          '?subject=' + encodeURIComponent('Inquiry: ' + item) +
          '&body=' + encodeURIComponent('Hello, I am interested in ' + item + '.\n\n');
      }
    })();
  </script>
</Base>
