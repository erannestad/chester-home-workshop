---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Column from '../components/Column.astro';

const page = await getEntry('pages', 'about');
const { Content } = page ? await render(page) : { Content: null };
---

<Base title={page?.data.title || 'About'} description={page?.data.intro} image={page?.data.image}>
  <Column label={page?.data.title || 'About'} wide>
    <dl class="rows">
      <div>
        <dt><h1 class="title">{page?.data.heading || page?.data.title || 'About'}</h1></dt>
        <dd>
          {page?.data.intro && <p>{page.data.intro}</p>}
          <div class="prose">{Content && <Content />}</div>
        </dd>
      </div>
    </dl>
  </Column>
  {
    page?.data.image && (
      <Column label={page.data.image_alt || ''}>
        <Image
          src={page.data.image}
          alt={page.data.image_alt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 56rem) 40vw, 100vw"
          priority
        />
      </Column>
    )
  }
</Base>
