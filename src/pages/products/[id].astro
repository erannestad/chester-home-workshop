---
import type { GetStaticPaths } from 'astro';
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import Column from '../../components/Column.astro';
import BuyBox from '../../components/BuyBox.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategories, getProducts, priceLine, STATUS_LABEL, type Product } from '../../lib/catalog';
import { link } from '../../lib/site';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const category = (await getCategories()).find((c) => c.id === product.category);
const others = (await getProducts()).filter((p) => p.id !== product.id && p.category === product.category);
---

<Base title={product.title} description={product.summary} image={product.images[0]}>
  <Column label={category ? `Shop / ${category.title}` : 'Shop'} href={link(category ? `/shop/${category.id}/` : '/shop/')} wide>
    <dl class="rows">
      <div>
        <dt>
          <h1 class="title">{product.title}</h1>
          {priceLine(product)}
          {product.status !== 'available' && <><br /><span class="label">{STATUS_LABEL[product.status]}</span></>}
        </dt>
        <dd>
          {product.summary && <p>{product.summary}</p>}
          {product.bodyHtml && <div class="prose" set:html={product.bodyHtml} />}
          <BuyBox product={product} />
        </dd>
      </div>
      {
        product.details.map((d) => (
          <div class="row-tight">
            <dt>{d.label}</dt>
            <dd>{d.value}</dd>
          </div>
        ))
      }
    </dl>
  </Column>

  <Column label={product.title}>
    <div class="photos">
      {
        product.images.length ? (
          product.images.map((img, i) => (
            <Photo
              src={img}
              alt={i === 0 ? product.title : `${product.title}, view ${i + 1}`}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 56rem) 36vw, 100vw"
              priority={i === 0}
            />
          ))
        ) : (
          <div class="placeholder" aria-hidden="true" />
        )
      }
    </div>
  </Column>

  {
    others.length > 0 && (
      <Column label={category ? `More ${category.title}` : 'More'} href={category && link(`/shop/${category.id}/`)}>
        {others.map((p, i) => (
          <ProductCard product={p} index={i + 1} />
        ))}
      </Column>
    )
  }
</Base>
