---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Column from '../components/Column.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCategories, getProducts } from '../lib/catalog';
import { settings, instagramUrl, instagramHandle, link } from '../lib/site';

const page = await getEntry('pages', 'home');
const categories = await getCategories();
const products = await getProducts();
const tel = settings.phone.replace(/[^\d+]/g, '');

// Featured items go first within each category column.
const inCategory = (id: string) =>
  products.filter((p) => p.category === id).sort((a, b) => Number(b.featured) - Number(a.featured));
---

<Base description={page?.data.intro || settings.tagline} image={page?.data.image}>
  <Column wide>
    {
      page?.data.image && (
        <Image
          src={page.data.image}
          alt={page.data.image_alt}
          class="lead-image"
          widths={[480, 720, 1080]}
          sizes="(min-width: 56rem) 36vw, 100vw"
          priority
        />
      )
    }
    <dl class="rows">
      <div>
        <dt>
          {settings.location && <>{settings.location}<br /></>}
          {settings.email && <><a href={`mailto:${settings.email}`}>{settings.email}</a><br /></>}
          {settings.phone && <><a href={`tel:${tel}`}>{settings.phone}</a><br /></>}
          {settings.instagram && <a href={instagramUrl(settings.instagram)}>{instagramHandle(settings.instagram)}</a>}
        </dt>
        <dd>
          <h1 class="title">{page?.data.heading || settings.site_name}</h1>
          {page?.data.intro && <p>{page.data.intro}</p>}
        </dd>
      </div>
      {
        categories.length > 0 && (
          <div>
            <dt>What we make</dt>
            <dd>
              {categories.map((c) => (
                <p>
                  <a href={link(`/shop/${c.id}/`)}>{c.title}</a>
                  {c.summary && <><br /><span class="muted">{c.summary}</span></>}
                </p>
              ))}
            </dd>
          </div>
        )
      }
      <div>
        <dt>Commissions</dt>
        <dd>
          <p>
            Custom fabric colors, painted commissions and upholstery work are quoted individually.{' '}
            <a href={link('/contact/')}>Get in touch</a> with what you have in mind.
          </p>
        </dd>
      </div>
    </dl>
  </Column>

  {
    categories.map((c, ci) => (
      <Column label={c.title} href={link(`/shop/${c.id}/`)}>
        {inCategory(c.id).map((p, i) => (
          <ProductCard product={p} index={i + 1} priority={ci < 2 && i === 0} />
        ))}
        {inCategory(c.id).length === 0 && <p class="empty">Nothing listed right now.</p>}
      </Column>
    ))
  }
</Base>
