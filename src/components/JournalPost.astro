---
/*
  One journal post. Closed: a photo, thumbnails and the caption, all linking to the post.
  Open (`photo` set): two columns wide, one large photo at a time with Previous / Next.
  Every state is a real page (/journal/{id}/{n}/); the script in Home.astro swaps them in place.
*/
import Photo from './Photo.astro';
import { formatDate, type Post } from '../lib/journal';
import { link } from '../lib/site';

interface Props {
  post: Post;
  priority?: boolean;
  photo?: number; // open the post at this photo (1-based)
  tone?: number; // 0–3, cycles the rusty photo pass
  pass?: boolean; // gray/color photo pass (duplicate img so the pass can ease off)
  colorFirst?: boolean; // leave this post's first photo in color
}

const tones = ['ochre', 'mustard', 'plum', 'olive'] as const;
const { post, priority = false, photo, tone = 0, pass = false, colorFirst = false } = Astro.props;
const open = photo !== undefined;
const [first, ...others] = post.images;
const rest = others.slice(0, 4); // one row under the closed post; the gallery shows them all
const count = Math.max(1, post.images.length);
const current = Math.min(Math.max(photo ?? 1, 1), count);
const wrap = (n: number) => ((n - 1 + count) % count) + 1;
const href = (n: number) => link(`/journal/${post.id}/${n > 1 ? `${n}/` : ''}`) + `#${post.id}`;
// The open view is one fixed frame that fits every photo, so stepping through them never resizes the post.
const ratios = post.images.map((img) => img.width / img.height);
const frame = ratios.length ? `--widest: ${Math.max(...ratios)}` : undefined;
---

<article class:list={['post', { 'post--open': open }]} id={post.id} data-count={count} data-title={post.title} data-span={post.span} data-tone={tones[tone % 4]}>
  <div class="post-closed">
    {
      first && (
        <a class="post-photo" href={href(1)} data-photo="1">
          <Photo
            src={first}
            alt={post.title}
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 56rem) 20vw, 100vw"
            priority={priority}
            pass={pass && !colorFirst}
          />
        </a>
      )
    }
    {
      rest.length > 0 && (
        <div class="post-more">
          {rest.map((img, i) => (
            <a class="post-photo" href={href(i + 2)} data-photo={i + 2}>
              <Photo src={img} alt={`${post.title}, photo ${i + 2}`} widths={[120, 200, 320]} sizes="(min-width: 56rem) 5vw, 25vw" pass={pass} />
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="post-gallery">
    <div class="post-topbar">
      {count > 1 && (
        <div class="post-topbar-controls">
          <a class="paddle" href={href(wrap(current - 1))} data-photo={wrap(current - 1)} data-step="prev" aria-label="Previous photo">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M10 3L5 8L10 13" />
            </svg>
          </a>
          <a class="paddle" href={href(wrap(current + 1))} data-photo={wrap(current + 1)} data-step="next" aria-label="Next photo">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M6 3L11 8L6 13" />
            </svg>
          </a>
        </div>
      )}
      <a class="post-topbar-close" href={link('/') + `#${post.id}`} data-close aria-label="Close">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3 3L13 13M13 3L3 13" />
        </svg>
      </a>
    </div>
    <div class:list={['post-stage', { 'post-stage--single': count === 1 }]} style={frame}>
      <div class="post-view">
        {
          post.images.map((img, i) => (
            <div class="post-slide" hidden={i !== current - 1}>
              {count > 1 ? (
                <a class="post-photo" href={href(wrap(current + 1))} data-photo={wrap(current + 1)} data-step="next">
                  <Photo
                    src={img}
                    alt={`${post.title}, photo ${i + 1} of ${count}`}
                    widths={[480, 720, 1080, 1600]}
                    sizes="(min-width: 56rem) 50vw, 100vw"
                    priority={open && i === current - 1}
                  />
                </a>
              ) : (
                <div class="post-photo">
                  <Photo src={img} alt={post.title} widths={[480, 720, 1080, 1600]} sizes="(min-width: 56rem) 50vw, 100vw" priority={open} />
                </div>
              )}
            </div>
          ))
        }
      </div>
      {
        count > 1 && (
          <div class="post-side">
            <div class="post-thumbs">
              {post.images.map((img, i) => (
                <a href={href(i + 1)} data-photo={i + 1} aria-current={i === current - 1 ? 'true' : undefined}>
                  <Photo src={img} alt={`Photo ${i + 1}`} widths={[120, 240]} sizes="3.5rem" pass={pass} />
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div class="caption">
    {post.date && (
      <p class="caption-index">
        <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
      </p>
    )}
    <div class="caption-copy">
      <h3 class="title"><a href={href(1)} data-photo="1">{post.title}</a></h3>
      {post.bodyHtml && <div class="prose" set:html={post.bodyHtml} />}
    </div>
  </div>
</article>
