---
import { settings, link } from '../lib/site';

const links = [
  { href: link('/shop/'), label: 'Shop' },
  { href: link('/about/'), label: 'About' },
  { href: link('/contact/'), label: 'Contact' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  path === href ||
  (href === link('/shop/') && (path.startsWith(link('/shop/')) || path.startsWith(link('/products/'))));
---

<header class="site-header">
  <a class="wordmark" href={link('/')}>{settings.site_name}</a>
  <nav class="site-nav" aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
