---
/* The thin bar with the site name and menu: along the bottom of the frame on wide screens, at the top on phones. */
import { settings, instagramUrl, facebookUrl, link } from '../lib/site';

const year = new Date().getFullYear();
const path = Astro.url.pathname;
const current = (href: string, prefixes: string[] = []) =>
  path === href || prefixes.some((p) => path.startsWith(p)) ? 'page' : undefined;
---

<header class="bar">
  <a class="wordmark" href={link('/')}>{settings.site_name}</a>
  <nav aria-label="Main">
    <ul>
      <li><a href={link('/shop/')} aria-current={current(link('/shop/'), [link('/shop/'), link('/products/')])}>Shop</a></li>
      <li><a href={link('/about/')} aria-current={current(link('/about/'))}>About</a></li>
      <li><a href={link('/contact/')} aria-current={current(link('/contact/'))}>Contact</a></li>
      {settings.instagram && <li><a href={instagramUrl(settings.instagram)}>Instagram</a></li>}
      {settings.facebook && <li><a href={facebookUrl(settings.facebook)}>Facebook</a></li>}
    </ul>
  </nav>
  <p class="fine">
    © {settings.site_name} {year} · <a href="https://app.pagescms.org" target="_blank" rel="noreferrer">Admin</a>
  </p>
</header>
<footer class="foot">
  <p class="fine">
    © {settings.site_name} {year} · <a href="https://app.pagescms.org" target="_blank" rel="noreferrer">Admin</a>
  </p>
</footer>
