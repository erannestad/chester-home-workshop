---
/*
  The home page: info column plus the journal. Also renders /journal/{id}/ pages, where `open`
  names the post to show two columns wide with one large photo.
*/
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Column from './Column.astro';
import JournalPost from './JournalPost.astro';
import JournalProduct from './JournalProduct.astro';
import JournalCategory from './JournalCategory.astro';
import HomeArt from './HomeArt.astro';
import { getCategories, getFeaturedCategory, getJournalProducts, getProducts, type ProductImage } from '../lib/catalog';
import { getPosts, journalPeriod, scatterEvery } from '../lib/journal';
import { CMS, cmsEditUrl, settings, link } from '../lib/site';

interface Props {
  open?: { id: string; photo: number };
  title?: string;
  description?: string;
  image?: ProductImage | null;
}

const { open, title, description, image } = Astro.props;
const page = await getEntry('pages', 'home');
const contact = await getEntry('pages', 'contact');
const categories = await getCategories();
// Upholstery is offered as a service, so it sits under Services instead of Shop.
const services = categories.filter((c) => c.id === 'upholstery');
const shopCategories = categories.filter((c) => c.id !== 'upholstery');
const posts = await getPosts();
const journalProducts = await getJournalProducts();
const feed = scatterEvery(posts, journalProducts, (p) => p.id, (p) => p.id);
const featuredCategory = await getFeaturedCategory();
const featuredProducts = featuredCategory
  ? (await getProducts()).filter((p) => p.category === featuredCategory.id)
  : [];
const featuredPhotos = featuredProducts
  .filter((p) => p.images.length)
  .map((p) => ({ src: p.images[0], alt: p.title, href: link(`/products/${p.id}/`) }));
---

<Base title={title} description={description || page?.data.intro || settings.tagline} image={image ?? page?.data.image}>
  <Column wide>
    <HomeArt />
    <dl class="rows rows--split">
      <div>
        <dt>
          <h1 class="visually-hidden">{settings.site_name}</h1>
          <a href={link('/about/')}>About</a>
        </dt>
        <dd>{page?.data.intro && <p>{page.data.intro}</p>}</dd>
      </div>
      {
        shopCategories.length > 0 && (
          <div class:list={['pin-bottom', { 'shop-block': services.length > 0 }]}>
            <dt><a href={link('/shop/')}>Shop</a></dt>
            <dd>
              {shopCategories.map((c) => (
                <p>
                  <a href={link(`/shop/${c.id}/`)}>{c.title}</a>
                  {c.summary && <span class="muted shop-summary">{c.summary}</span>}
                </p>
              ))}
            </dd>
          </div>
        )
      }
      {
        services.length > 0 && (
          <div class:list={[{ 'pin-bottom': shopCategories.length === 0 }]}>
            <dt>Services</dt>
            <dd>
              {services.map((c) => (
                <p>
                  <a href={link(`/shop/${c.id}/`)}>{c.title}</a>
                  {c.summary && <span class="muted shop-summary">{c.summary}</span>}
                </p>
              ))}
            </dd>
          </div>
        )
      }
      <div class:list={[{ 'pin-bottom': shopCategories.length === 0 && services.length === 0 }]}>
        <dt><a href={link('/contact/')}>Contact</a></dt>
        <dd>
          {contact?.data.intro && <p>{contact.data.intro}</p>}
          <p><a href={link('/contact/')}>Contact us</a></p>
        </dd>
      </div>
    </dl>
  </Column>

  <Column label={page?.data.featured_heading || 'Journal'} journal>
    {
      posts.length || journalProducts.length ? (
        <>
        <svg class="visually-hidden" width="0" height="0" aria-hidden="true">
          <filter id="journal-paper" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="2" stitchTiles="stitch" result="blot"></feTurbulence>
            <feComponentTransfer in="blot" result="coverage">
              <feFuncR type="linear" slope="0.22" intercept="0.78"></feFuncR>
              <feFuncG type="linear" slope="0.22" intercept="0.78"></feFuncG>
              <feFuncB type="linear" slope="0.22" intercept="0.78"></feFuncB>
            </feComponentTransfer>
            <feBlend in="SourceGraphic" in2="coverage" mode="multiply" result="laid"></feBlend>
            <feTurbulence type="turbulence" baseFrequency="0.45" numOctaves="1" seed="9" stitchTiles="stitch" result="stipple"></feTurbulence>
            <feComponentTransfer in="stipple" result="dots">
              <feFuncR type="linear" slope="2.8" intercept="-0.9"></feFuncR>
              <feFuncG type="linear" slope="2.8" intercept="-0.9"></feFuncG>
              <feFuncB type="linear" slope="2.8" intercept="-0.9"></feFuncB>
            </feComponentTransfer>
            <feComponentTransfer in="dots" result="ink">
              <feFuncR type="linear" slope="0.32" intercept="0.68"></feFuncR>
              <feFuncG type="linear" slope="0.32" intercept="0.68"></feFuncG>
              <feFuncB type="linear" slope="0.32" intercept="0.68"></feFuncB>
            </feComponentTransfer>
            <feBlend in="laid" in2="ink" mode="multiply"></feBlend>
          </filter>
        </svg>
        <div
          class:list={[
            'journal',
            { 'journal--tone': settings.journal_photos !== 'color' },
            { 'journal--gray': settings.journal_photos === 'gray' },
          ]}
          data-base={link('/')}
          data-site={settings.site_name}
          data-cms={CMS}
          data-edit-home={cmsEditUrl('/')}
        >
          {feed.map((entry, i) => {
            if (entry.kind === 'extra') {
              return <JournalProduct product={entry.value} priority={!open && i < 3} />;
            }
            const post = entry.value;
            const prevPost = [...feed.slice(0, i)].reverse().find((e) => e.kind === 'item');
            const period = post.date && journalPeriod(post.date, settings.journal_divider);
            const prevDate = prevPost?.kind === 'item' ? prevPost.value.date : null;
            const prev = prevDate ? journalPeriod(prevDate, settings.journal_divider) : period;
            return (
              <>
                {period && period.key !== prev?.key && (
                  <div class="journal-year">
                    <h2 class="journal-year-label">{period.label}</h2>
                  </div>
                )}
                <JournalPost post={post} priority={!open && i < 3} photo={open?.id === post.id ? open.photo : undefined} tone={entry.index % 4} pass={settings.journal_photos !== 'color'} colorFirst={!!page?.data.first_photo_color && i === 0} />
              </>
            );
          })}
          {featuredCategory && <JournalCategory category={featuredCategory} count={featuredProducts.length} photos={featuredPhotos} />}
        </div>
        </>
      ) : (
        <p class="empty">Nothing here yet.</p>
      )
    }
  </Column>
</Base>

<script>
  // Opens journal posts and steps through their photos in place, keeping the address bar in
  // step with the real pages (/journal/{id}/{n}/) so reload, sharing and Back all work.
  const journal = document.querySelector<HTMLElement>('.journal');

  if (journal) {
    // Color first, then the gray pass. Reduced motion stays gray from the first paint.
    window.setTimeout(() => journal.classList.add('is-settled'), 1000);
    const base = journal.dataset.base ?? '/';
    const site = journal.dataset.site ?? document.title;
    const cms = journal.dataset.cms ?? '';
    const editHome = journal.dataset.editHome ?? '';
    const edits = document.querySelectorAll<HTMLAnchorElement>('.cms-edit');
    const pattern = new RegExp(`^${base}journal/([^/]+)/(?:(\\d+)/)?$`);
    const syncEdit = (id: string | null) => {
      const href = id
        ? `${cms}/collection/journal/edit/${encodeURIComponent(`src/content/journal/${id}.md`)}`
        : editHome;
      if (!href) return;
      for (const a of edits) a.href = href;
    };
    const wrap = (n: number, count: number) => ((n - 1 + count) % count) + 1;
    const url = (id: string, n: number) => `${base}journal/${id}/${n > 1 ? `${n}/` : ''}`;
    const path = (href: string) => new URL(href, location.origin).pathname;
    const openPost = () => journal.querySelector<HTMLElement>('.post--open');
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    const px = (value: string) => parseFloat(value) * (value.includes('rem') ? rem : 1);
    const tokens = getComputedStyle(document.documentElement);
    const colMin = px(tokens.getPropertyValue('--col-min'));
    const packMin = px(tokens.getPropertyValue('--journal-min'));
    const threeMin = px(tokens.getPropertyValue('--journal-min-3'));
    const fourMin = px(tokens.getPropertyValue('--journal-min-4'));
    const gap = px(tokens.getPropertyValue('--pad')) * 2;
    const scroller = (el: HTMLElement) => {
      for (let p = el.parentElement; p; p = p.parentElement) {
        const y = getComputedStyle(p).overflowY;
        if (y === 'auto' || y === 'scroll') return p;
      }
      return (document.scrollingElement ?? document.documentElement) as HTMLElement;
    };
    const keep = (el: HTMLElement, run: () => void) => {
      const box = scroller(el);
      const top = el.getBoundingClientRect().top;
      run();
      box.scrollTop += el.getBoundingClientRect().top - top;
    };
    let packed = '';
    let packing = false;
    const corner = journal.querySelector<HTMLElement>('.journal-feature');
    const body = journal.closest<HTMLElement>('.col-body');
    journal.style.paddingBottom = '';
    const order = [...journal.querySelectorAll<HTMLElement>(':scope > .post, :scope > .journal-year')].flatMap((el) => {
      if (!el.classList.contains('post') || Math.random() >= 0.5) return [el];
      const space = document.createElement('div');
      space.className = 'journal-space';
      space.setAttribute('aria-hidden', 'true');
      return [el, space];
    });

    const pack = () => {
      if (packing) return;
      // 3 and 4 columns use narrower mins so they hold further as the window shrinks
      // (--journal-min-4, then --journal-min and --journal-min-3); 5+ stay on --col-min so a normal desktop doesn't pick
      // up an extra column.
      const inner = journal.clientWidth + gap;
      const full = Math.max(1, Math.floor(inner / (colMin + gap)));
      const tight = Math.max(1, Math.floor(inner / (packMin + gap)));
      const fitsFour = inner >= 4 * (fourMin + gap);
      const fitsThree = inner >= 3 * (threeMin + gap);
      const n = full >= 5 ? full : fitsFour ? 4 : tight >= 3 ? 3 : fitsThree ? 3 : tight;
      const open = order.find((p) => p.classList.contains('post--open'));
      const padTop = body ? parseFloat(getComputedStyle(body).paddingTop) : 0;
      const padBottom = body ? parseFloat(getComputedStyle(body).paddingBottom) : 0;
      const viewH = body ? body.clientHeight - padTop - padBottom : journal.clientHeight;
      const key = `${n}:${Math.round(journal.clientWidth)}:${Math.round(viewH)}:${open?.id ?? ''}`;
      if (key === packed) return;
      packed = key;
      packing = true;
      try {
      journal.style.setProperty('--cols', String(n));
      journal.classList.add('is-packed');
      corner?.classList.remove('is-pinned');

      const i = open ? order.indexOf(open) : -1;
      const before = i === -1 ? order : order.slice(0, i);
      const after = i === -1 ? [] : order.slice(i + 1);

      type Hole = { col: number; span: number; top: number; bottom: number };

      // pin: 'view' = bottom right of the first screen, 'top' = top right of the pack.
      const fill = (name: string, items: HTMLElement[], feature: HTMLElement | null, pin: 'view' | 'top' | null) => {
        let row = journal.querySelector<HTMLElement>(`:scope > .journal-pack[data-pack="${name}"]`);
        if (!items.length && !feature) {
          row?.remove();
          return;
        }
        if (!row) {
          row = document.createElement('div');
          row.className = 'journal-pack';
          row.dataset.pack = name;
        }
        row.replaceChildren(...items, ...(feature ? [feature] : []));
        journal.append(row);

        const track = (journal.clientWidth - (n - 1) * gap) / n;
        const colH = Array.from({ length: n }, () => 0);
        const width = (span: number) => span * track + (span - 1) * gap;
        // Half a gutter less the rule, so the frame's lines meet the vertical rule on its left
        // and the rule itself stays visible.
        const box = (el: HTMLElement, col: number, span: number) => {
          const bleed = el === feature && col > 0 ? gap / 2 - 1 : 0;
          if (el === feature) el.style.setProperty('--bleed', `${bleed}px`);
          el.style.width = `${width(span) + bleed}px`;
          el.style.left = `${col * (track + gap) - bleed}px`;
        };
        const hit = (hole: Hole | null, col: number, span: number, y: number, h: number) =>
          !!hole &&
          col < hole.col + hole.span &&
          hole.col < col + span &&
          y < hole.bottom &&
          y + h > hole.top;
        const startY = (col: number, span: number, hole: Hole | null) => {
          let y = Math.max(...colH.slice(col, col + span));
          if (hole && hit(hole, col, span, y, 1) && y < hole.bottom) y = hole.bottom;
          return y;
        };
        const place = (el: HTMLElement, col: number, span: number, hole: Hole | null, at?: number) => {
          box(el, col, span);
          if (el.classList.contains('post')) el.classList.toggle('post--span', span > 1);
          let y = at ?? startY(col, span, hole);
          const h = el.offsetHeight;
          if (hole && hit(hole, col, span, y, h)) y = hole.bottom;
          el.style.top = `${y}px`;
          for (let c = col; c < col + span; c++) colH[c] = y + h;
        };

        const spanOf = (el: HTMLElement) => {
          const want = el.classList.contains('post') ? Number(el.dataset.span) || 1 : 1;
          // Small = 1 column, Medium = 2, Large = 2 (3 only once there are 4+ columns).
          const cap = want >= 3 && n < 4 ? 2 : want;
          return Math.min(n, Math.max(1, cap));
        };

        let hole: Hole | null = null;
        let rest = items;
        if (feature && pin && n > 1) {
          // The first post always takes the top left; on short screens the category drops
          // below it rather than pushing it down.
          const span = (n >= 4 ? 3 : Math.min(2, n));
          // A season line is an anchor handled below, never the clamped first post.
          if (items.length && !items[0].classList.contains('journal-year')) {
            // Narrower if it would otherwise share a column with the category, but Medium and
            // Large never drop below 2.
            const first = spanOf(items[0]);
            place(items[0], 0, Math.max(Math.min(first, 2), Math.min(first, n - span)), null);
            rest = items.slice(1);
          }
          const col = n - span;
          box(feature, col, span);
          const h = feature.offsetHeight;
          // 'view': the frame's bottom rule sits 1px past the column's edge, under the bar's
          // top rule, so the two read as one line.
          const frame = feature.querySelector<HTMLElement>('.journal-feature-frame');
          const frameH = frame ? frame.offsetHeight : h;
          const want = pin === 'view' ? Math.max(0, viewH + padBottom + 1 - frameH) : 0;
          const top = Math.max(want, ...colH.slice(col, col + span));
          feature.style.top = `${top}px`;
          hole = { col, span, top, bottom: top + h };
        }

        for (const el of rest) {
          // A season or year line spans the whole journal and stays where the posts above end.
          // Every column starts fresh under it, so the next posts share that top and flow around
          // the featured category from there.
          if (el.classList.contains('journal-year')) {
            const y = Math.max(0, ...colH);
            box(el, 0, n);
            el.style.top = `${y}px`;
            const h = el.offsetHeight;
            for (let c = 0; c < n; c++) colH[c] = Math.max(colH[c], y + h);
            continue;
          }
          const span = spanOf(el);
          let col = 0;
          let best = Infinity;
          for (let c = 0; c <= n - span; c++) {
            const y = startY(c, span, hole);
            if (y < best) {
              best = y;
              col = c;
            }
          }
          place(el, col, span, hole);
        }

        if (feature && !hole) {
          const span = (n >= 4 ? 3 : Math.min(2, n));
          place(feature, n > 1 ? n - span : 0, span, null);
        }

        const packedH = Math.max(0, ...colH, hole?.bottom ?? 0);
        row.style.height = `${packedH}px`;
      };

      // The category sits at the bottom right of the first screen. If an open post is so near
      // the top that nothing fills that screen, it sits just under the open post instead.
      let cornerHome: 'before' | 'after' = 'before';
      if (open && corner) {
        fill('before', before, null, null);
        const beforeRow = journal.querySelector<HTMLElement>(':scope > .journal-pack[data-pack="before"]');
        const beforeH = beforeRow ? parseFloat(beforeRow.style.height) || 0 : 0;
        if (n === 1 || beforeH < viewH) cornerHome = 'after';
      }
      fill('before', before, cornerHome === 'before' ? corner : null, 'view');
      if (open) {
        open.classList.remove('post--span');
        open.style.left = '';
        open.style.top = '';
        open.style.width = '';
        journal.append(open);
      }
      fill('after', after, cornerHome === 'after' ? corner : null, 'top');
      } finally {
        packing = false;
      }
    };

    const relayout = () => {
      const open = openPost();
      if (open) keep(open, pack);
      else pack();
    };

    const show = (id: string | null, n = 1) => {
      document.title = site;
      for (const post of journal.querySelectorAll<HTMLElement>('.post')) {
        const isOpen = post.id === id;
        post.classList.toggle('post--open', isOpen);
        if (!isOpen) continue;

        const count = Number(post.dataset.count) || 1;
        const photo = Math.min(Math.max(n, 1), count);
        post.querySelectorAll<HTMLElement>('.post-slide').forEach((slide, i) => (slide.hidden = i !== photo - 1));
        post.querySelectorAll<HTMLElement>('.post-thumbs a').forEach((a, i) => {
          if (i === photo - 1) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
        post.querySelectorAll<HTMLAnchorElement>('[data-step]').forEach((a) => {
          const target = wrap(a.dataset.step === 'prev' ? photo - 1 : photo + 1, count);
          a.href = url(post.id, target);
          a.dataset.photo = String(target);
        });
        const counter = post.querySelector('.post-count');
        if (counter) counter.textContent = `${photo} / ${count}`;
        document.title = `${post.dataset.title} · ${site}`;
      }
      syncEdit(id);
      pack();
    };

    const go = (post: HTMLElement, a: HTMLAnchorElement) => {
      const closing = a.hasAttribute('data-close');
      const wasOpen = post.classList.contains('post--open');
      const href = path(a.href); // show() rewrites the step links, this one included
      if (closing || !wasOpen) keep(post, () => show(closing ? null : post.id, Number(a.dataset.photo) || 1));
      else show(post.id, Number(a.dataset.photo) || 1);
      // A new history entry for opening or closing a post; stepping through photos replaces it.
      if (wasOpen && !closing) history.replaceState(null, '', href);
      else history.pushState(null, '', href);
    };

    journal.addEventListener('click', (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-photo], a[data-close]');
      const post = a?.closest<HTMLElement>('.post');
      if (!a || !post) return;
      e.preventDefault();
      go(post, a);
    });

    // A click anywhere outside the open entry closes it. Links still navigate, and a click
    // that opens another entry is handled above.
    document.addEventListener('click', (e) => {
      if (e.button !== 0 || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const post = openPost();
      if (!post) return;
      const target = e.target;
      if (!(target instanceof Element) || target.closest('.post--open') || target.closest('a')) return;
      const close = post.querySelector<HTMLAnchorElement>('a[data-close]');
      if (close) go(post, close);
    });

    document.addEventListener('keydown', (e) => {
      const post = openPost();
      if (!post || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.target instanceof Element && e.target.closest('input, textarea, select')) return;
      const selector = { ArrowLeft: '[data-step="prev"]', ArrowRight: '[data-step="next"]', Escape: '[data-close]' }[e.key];
      const a = selector && post.querySelector<HTMLAnchorElement>(selector);
      if (!a) return;
      e.preventDefault();
      go(post, a);
    });

    window.addEventListener('popstate', () => {
      const match = location.pathname.match(pattern);
      const id = match ? decodeURIComponent(match[1]) : null;
      const post = (id && document.getElementById(id)) || openPost();
      if (post) keep(post, () => show(id, Number(match?.[2]) || 1));
      else show(id, Number(match?.[2]) || 1);
    });

    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    const initial = openPost();
    if (initial) keep(initial, pack);
    else pack();
    new ResizeObserver(relayout).observe(journal);
    if (body) new ResizeObserver(relayout).observe(body);
    journal.querySelectorAll('img').forEach((img) => {
      if (img.complete || img.closest('.post-gallery')) return;
      img.addEventListener('load', () => { packed = ''; relayout(); }, { once: true });
    });
  }
</script>
