---
/*
  Responsive, optimized image for catalog photos.
  Handles local photos (from the CMS) and remote URLs (if products later come from Square/Shopify).
*/
import { Image } from 'astro:assets';
import type { ProductImage } from '../lib/catalog';

interface Props {
  src: ProductImage;
  alt: string;
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
  /** Second copy with the journal pass, so grain sits in the photo and the whole pass can ease off. */
  pass?: boolean;
}

const { src, alt, widths, sizes, priority = false, class: className, pass = false } = Astro.props;
---

{
  typeof src === 'string' ? (
    <Image src={src} inferSize alt={alt} widths={widths} sizes={sizes} priority={priority} class={className} />
  ) : (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} priority={priority} class={className} />
  )
}
{
  pass && (
    <span class="post-pass" aria-hidden="true">
      {typeof src === 'string' ? (
        <Image src={src} inferSize alt="" widths={widths} sizes={sizes} class={className} />
      ) : (
        <Image src={src} alt="" widths={widths} sizes={sizes} class={className} />
      )}
    </span>
  )
}
